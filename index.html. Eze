<script>

const marketSets = {

crypto:[
"BTC/USD",
"ETH/USD",
"LTC/USD",
"XRP/USD",
"BCH/USD"
],

forex:[
"EUR/USD",
"GBP/USD",
"USD/JPY",
"AUD/USD",
"USD/CAD",
"EUR/GBP"
],

gold:[
"XAU/USD"
]

};


let mode="demo";

let scannerTimer=null;

let scanIndex=0;

let ws=null;

let auth={
token:null,
account:null,
wsUrl:null
};

let publicSymbols=[];

let symbolPrices={};

let cryptoIndex=0;

let forexIndex=0;


function localClock(){

document.getElementById("clock").textContent =
new Intl.DateTimeFormat(
undefined,
{
dateStyle:"medium",
timeStyle:"medium"
}
).format(new Date());

}

setInterval(localClock,1000);

localClock();


function setMode(m){

mode=m;

document.getElementById("mode").textContent=
m.toUpperCase();

document.getElementById("modeTitle").textContent=
m==="real"
?
"REAL ACCOUNT"
:
"DEMO ACCOUNT";

document.getElementById("demoBtn")
.classList
.toggle("active",m==="demo");

document.getElementById("realBtn")
.classList
.toggle("active",m==="real");


if(m==="demo"){

document.getElementById("connection")
.textContent=
"Demo simulation — no real-money orders";

}

else{

document.getElementById("connection")
.textContent=
auth.token
?
"Deriv authenticated"
:
"Connect Deriv to enable real account";

}

}


function randomString(length=64){

const chars=
"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";

let result="";

const values=
new Uint8Array(length);

crypto.getRandomValues(values);

for(const value of values){

result+=
chars[value % chars.length];

}

return result;

}


function base64url(bytes){

let binary="";

for(const byte of bytes){

binary+=String.fromCharCode(byte);

}

return btoa(binary)
.replace(/\+/g,"-")
.replace(/\//g,"_")
.replace(/=+$/,"");

}


async function pkce(){

const verifier=randomString(64);

const hash=
await crypto.subtle.digest(
"SHA-256",
new TextEncoder().encode(verifier)
);

return {

verifier,

challenge:
base64url(new Uint8Array(hash)),

state:
crypto.randomUUID()

};

}


async function loginDeriv(){

try{

const config=
await fetch("/api/config")
.then(r=>r.json());


if(!config.configured){

alert(
"Vercel is missing DERIV_CLIENT_ID or DERIV_REDIRECT_URI."
);

return;

}


const pk=
await pkce();


sessionStorage.setItem(
"pkce_verifier",
pk.verifier
);

sessionStorage.setItem(
"oauth_state",
pk.state
);


const url=
new URL(
"https://auth.deriv.com/oauth2/auth"
);


url.searchParams.set(
"response_type",
"code"
);

url.searchParams.set(
"client_id",
config.clientId
);

url.searchParams.set(
"redirect_uri",
config.redirectUri
);

url.searchParams.set(
"scope",
config.scope
);

url.searchParams.set(
"state",
pk.state
);

url.searchParams.set(
"code_challenge",
pk.challenge
);

url.searchParams.set(
"code_challenge_method",
"S256"
);


location.href=url.toString();


}catch(error){

alert(error.message);

}

}


async function handleCallback(){

const params=
new URLSearchParams(
location.search
);

const code=params.get("code");

const state=params.get("state");


if(!code){

return;

}


if(
state !==
sessionStorage.getItem("oauth_state")
){

throw new Error(
"OAuth state mismatch."
);

}


const verifier=
sessionStorage.getItem(
"pkce_verifier"
);


const config=
await fetch("/api/config")
.then(r=>r.json());


const response=
await fetch(
"/api/token",
{
method:"POST",

headers:{
"Content-Type":
"application/json"
},

body:JSON.stringify({

code,

code_verifier:
verifier,

redirect_uri:
config.redirectUri

})

}
);


const data=
await response.json();


if(!response.ok){

throw new Error(
data.error ||
"Token exchange failed."
);

}


auth.token=
data.access_token;


sessionStorage.removeItem(
"pkce_verifier"
);

sessionStorage.removeItem(
"oauth_state"
);


history.replaceState(
{},
document.title,
"/"
);


document.getElementById(
"authStatus"
).innerHTML=
"<span class='ok'>Deriv OAuth authenticated.</span>";


await loadAccounts();

}


async function loadAccounts(){

if(!auth.token){

return;

}


const response=
await fetch(
"/api/accounts",
{
method:"POST",

headers:{
Authorization:
"Bearer "+auth.token
}

}
);


const data=
await response.json();


if(!response.ok){

throw new Error(
data.error ||
"Could not load Deriv accounts."
);

}


let accounts=[];


if(
Array.isArray(data.data)
){

accounts=data.data;

}

else if(
data.data &&
Array.isArray(data.data.accounts)
){

accounts=data.data.accounts;

}

else if(
Array.isArray(data.accounts)
){

accounts=data.accounts;

}


auth.account=
accounts[0] || null;


if(!auth.account){

document.getElementById(
"authStatus"
).textContent=
"OAuth succeeded, but no Options account was returned.";

return;

}


const accountId=
auth.account.account_id ||
auth.account.id ||
"Deriv account";


const balance=
auth.account.balance ??
auth.account.available_balance ??
"—";


const currency=
auth.account.currency ||
"";


document.getElementById(
"balance"
).textContent=
`${balance} ${currency}`;


document.getElementById(
"authStatus"
).innerHTML=
`<span class="ok">
Connected: ${accountId}
</span>`;


document.getElementById(
"connection"
).textContent=
"Deriv authenticated account connected";


}


async function connectAuthenticatedSocket(){

if(!auth.token || !auth.account){

throw new Error(
"Connect your Deriv account first."
);

}


const accountId=
auth.account.account_id ||
auth.account.id;


const response=
await fetch(
"/api/otp",
{
method:"POST",

headers:{
"Content-Type":
"application/json",

Authorization:
"Bearer "+auth.token

},

body:JSON.stringify({
accountId
})

}
);


const data=
await response.json();


if(!response.ok){

throw new Error(
data.error ||
"Unable to obtain Deriv WebSocket OTP."
);

}


const url=
data.data?.url ||
data.url;


if(!url){

throw new Error(
"Deriv did not return an authenticated WebSocket URL."
);

}


auth.wsUrl=url;


return new Promise(
(resolve,reject)=>{

const socket=
new WebSocket(url);


socket.onopen=()=>{

resolve(socket);

};


socket.onerror=()=>{

reject(
new Error(
"Authenticated Deriv WebSocket connection failed."
)
);

};

}
);

}


function disconnect(){

if(ws){

try{
ws.close();
}catch(_){}

ws=null;

}


auth={
token:null,
account:null,
wsUrl:null
};


document.getElementById(
"authStatus"
).textContent=
"Disconnected.";


document.getElementById(
"connection"
).textContent=
mode==="demo"
?
"Demo simulation — no real-money orders"
:
"Not connected";


document.getElementById(
"balance"
).textContent=
"—";

}


function getVisibleMarkets(){

const crypto=
marketSets.crypto[
cryptoIndex %
marketSets.crypto.length
];

const forex=
marketSets.forex[
forexIndex %
marketSets.forex.length
];

return [

{
group:"CRYPTO",
symbols:[
crypto,
marketSets.crypto[
(cryptoIndex+1) %
marketSets.crypto.length
]
]
},

{
group:"FOREX",
symbols:[
forex,
marketSets.forex[
(forexIndex+1) %
marketSets.forex.length
]
]
},

{
group:"GOLD",
symbols:[
"XAU/USD"
]
}

];

}


function renderMarkets(){

const container=
document.getElementById(
"markets"
);


const groups=
getVisibleMarkets();


container.innerHTML="";


groups.forEach(
(group)=>{

const wrapper=
document.createElement("div");

wrapper.className=
"marketGroup";


const title=
document.createElement("div");

title.className=
"marketTitle";

title.textContent=
group.group;


wrapper.appendChild(title);


group.symbols.forEach(
(symbol)=>{

const row=
document.createElement("div");

row.className=
"market";


const left=
document.createElement("span");

left.className=
"symbol";

left.textContent=
symbol;


const right=
document.createElement("span");


const price=
document.createElement("span");

price.className=
"price";

price.textContent=
symbolPrices[symbol] ??
"—";


const state=
document.createElement("span");

state.className=
"state";

state.textContent=
symbolPrices[symbol]
?
"LIVE"
:
"WAIT";


right.appendChild(price);

right.appendChild(
document.createTextNode(" ")
);

right.appendChild(state);


row.appendChild(left);

row.appendChild(right);

wrapper.appendChild(row);

});


container.appendChild(wrapper);

});

}


renderMarkets();


function rotateMarkets(){

cryptoIndex++;

forexIndex++;

renderMarkets();

subscribeCurrentMarkets();

}


function startScan(){

if(scannerTimer){

return;

}


scanIndex=0;


scannerTimer=
setInterval(
()=>{

scanIndex=
(scanIndex % 10)+1;

document.getElementById(
"scanNo"
).textContent=
"SCAN "+scanIndex;


if(scanIndex===10){

rotateMarkets();

}

},
100
);


document.getElementById(
"marketStatus"
).textContent=
"Connecting to Deriv public market stream…";


connectPublic();

}


function stopScan(){

clearInterval(
scannerTimer
);

scannerTimer=null;


document.getElementById(
"scanNo"
).textContent=
"SCAN 1";


if(ws){

try{
ws.close();
}catch(_){}

ws=null;

}

}


function allCurrentSymbols(){

const groups=
getVisibleMarkets();

return groups.flatMap(
g=>g.symbols
);

}


function subscribeCurrentMarkets(){

if(
!ws ||
ws.readyState !== WebSocket.OPEN
){

return;

}


for(
const symbol
of allCurrentSymbols()
){

const found=
publicSymbols.find(
item=>{

const value=
item.underlying_symbol ||
item.symbol ||
"";

return normalizeSymbol(value) ===
normalizeSymbol(symbol);

}
);


if(found){

const value=
found.underlying_symbol ||
found.symbol;


ws.send(
JSON.stringify({
ticks:value,
subscribe:1
})
);

}

}

}


function normalizeSymbol(symbol){

return String(symbol)
.toUpperCase()
.replace(/\//g,"")
.replace(/_/g,"");

}


function connectPublic(){

if(ws){

return;

}


ws=
new WebSocket(
"wss://api.derivws.com/trading/v1/options/ws/public"
);


ws.onopen=()=>{

document.getElementById(
"marketStatus"
).innerHTML=
"<span class='ok'>Deriv public stream connected</span>";


ws.send(
JSON.stringify({
active_symbols:"brief",
req_id:1
})
);

};


ws.onmessage=(event)=>{

try{

const data=
JSON.parse(event.data);


if(data.error){

document.getElementById(
"marketStatus"
).innerHTML=
`<span class="bad">
Deriv error: ${data.error.message}
</span>`;

return;

}


if(
data.msg_type==="active_symbols"
){

publicSymbols=
data.active_symbols ||
data.activeSymbols ||
[];


subscribeCurrentMarkets();

}


if(
data.msg_type==="tick"
){

const tick=
data.tick;


if(!tick){

return;

}


const symbol=
tick.symbol ||
tick.underlying_symbol;


const quote=
tick.quote;


if(
symbol &&
quote !== undefined
){

const normalized=
normalizeSymbol(symbol);


const match=
allCurrentSymbols()
.find(
item=>
normalizeSymbol(item)===normalized
);


if(match){

symbolPrices[match]=
Number(quote)
.toLocaleString(
undefined,
{
maximumFractionDigits:5
}
);

renderMarkets();

}

}

}

}
catch(error){

console.error(
"Market message error",
error
);

}

};


ws.onerror=()=>{

document.getElementById(
"marketStatus"
).innerHTML=
"<span class='bad'>Deriv public stream error</span>";

};


ws.onclose=()=>{

ws=null;

document.getElementById(
"marketStatus"
).textContent=
"Deriv public stream closed";

};

}


async function startBot(){

if(
mode==="real" &&
!auth.token
){

document.getElementById(
"botStatus"
).innerHTML=
"<span class='bad'>Real mode requires Deriv OAuth authentication first.</span>";

return;

}


document.getElementById(
"engine"
).textContent=
"RUNNING";


if(mode==="demo"){

document.getElementById(
"botStatus"
).innerHTML=
"<span class='warn'>Demo bot running — simulated only.</span>";

startScan();

return;

}


try{

const socket=
await connectAuthenticatedSocket();


ws=socket;


document.getElementById(
"botStatus"
).innerHTML=
"<span class='ok'>Authenticated Deriv trading connection established.</span>";


document.getElementById(
"marketStatus"
).innerHTML=
"<span class='ok'>Authenticated Deriv WebSocket connected.</span>";


socket.onmessage=
handleAuthenticatedMessage;


socket.send(
JSON.stringify({
balance:1,
subscribe:1,
req_id:100
})
);


socket.send(
JSON.stringify({
active_symbols:"brief",
req_id:101
})
);


}
catch(error){

document.getElementById(
"engine"
).textContent=
"WAIT";


document.getElementById(
"botStatus"
).innerHTML=
`<span class="bad">${error.message}</span>`;

}

}


function handleAuthenticatedMessage(event){

try{

const data=
JSON.parse(event.data);


console.log(
"Authenticated Deriv message",
data
);


if(
data.msg_type==="balance"
){

const balance=
data.balance?.balance ??
data.balance;


const currency=
data.balance?.currency ??
"";


if(balance !== undefined){

document.getElementById(
"balance"
).textContent=
`${balance} ${currency}`;

}

}


if(
data.error
){

document.getElementById(
"botStatus"
).innerHTML=
`<span class="bad">
Deriv error: ${data.error.message}
</span>`;

}

}
catch(error){

console.error(error);

}

}


function stopBot(){

document.getElementById(
